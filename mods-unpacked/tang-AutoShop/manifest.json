{
	"name": "AutoShop",
	"namespace": "tang",
	"version_number": "1.2.0",
	"description": "自动刷新商店并按图标白名单购买普通道具；F8 设置、F7 执行、F6 停止。",
	"website_url": "https://github.com/CPU31/Brotato-AutoShop",
	"dependencies": [],
	"extra": {
		"godot": {
			"authors": [
				"Tang Bin"
			],
			"compatible_mod_loader_version": [
				"6.3.0"
			],
			"compatible_game_version": [
				"1.1.15.4"
			],
			"config_schema": {
				"type": "object",
				"properties": {
					"enabled": {
						"type": "boolean",
						"default": true
					},
					"dry_run": {
						"type": "boolean",
						"default": false
					},
					"whitelist": {
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						}
					},
					"keep_gold": {
						"type": "integer",
						"default": 0,
						"minimum": 0
					},
					"max_item_price": {
						"type": "integer",
						"default": -1,
						"minimum": -1
					},
					"max_rerolls": {
						"type": "integer",
						"default": -1,
						"minimum": -1
					},
					"max_reroll_cost": {
						"type": "integer",
						"default": -1,
						"minimum": -1
					},
					"buy_weapons": {
						"type": "boolean",
						"default": false,
						"enum": [
							false
						]
					},
					"buy_consumables": {
						"type": "boolean",
						"default": false,
						"enum": [
							false
						]
					},
					"auto_depart": {
						"type": "boolean",
						"default": false
					},
					"confirm_delay": {
						"type": "number",
						"default": 0.2,
						"minimum": 0
					},
					"verbose": {
						"type": "boolean",
						"default": true
					},
					"preset_initialized": {
						"type": "boolean",
						"default": false
					}
				},
				"additionalProperties": false
			}
		}
	}
}
